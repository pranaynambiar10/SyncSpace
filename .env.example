# ──────────────────────────────────────────────
# SyncSpace Campus — Environment Variables
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to version control.
# ──────────────────────────────────────────────

# ── Supabase (public — safe for the browser) ──
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ──────────────────────────────────────────────
# The following variables are used ONLY by server-side scripts
# (seed.ts, reset.ts). They must NEVER be exposed to the browser
# or committed to version control.
# ──────────────────────────────────────────────

# Supabase service-role key (server-side seed scripts only)
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Comma-separated list of allowed email domains (used by seed script)
# Example: SEED_DEFAULT_EMAIL_DOMAINS=ug.cusat.ac.in,pg.cusat.ac.in
# This value is for the SEED only; the authoritative list lives in the
# allowed_email_domains table and is managed through the Admin UI.
# SEED_DEFAULT_EMAIL_DOMAINS=your-university-domain.edu

# Optional: override university name used by the seed
# SEED_UNIVERSITY_NAME=Cochin University of Science and Technology
# SEED_UNIVERSITY_SLUG=cusat

# ──────────────────────────────────────────────
# Optional — Google OAuth (Phase 11, not built yet)
# VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
# ──────────────────────────────────────────────
